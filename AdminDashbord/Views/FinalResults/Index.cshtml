@{
    var results = (List<AdminDashbord.Models.FinalResult>)ViewBag.Results;
    var answers = (List<AdminDashbord.Models.FinalMcqanswer>)ViewBag.Answers;
    var students = (List<AdminDashbord.Models.Student>)ViewBag.Students;
    var exams = (List<AdminDashbord.Models.FinalExam>)ViewBag.Exams;
    var mcqs = (List<AdminDashbord.Models.FinalMcq>)ViewBag.Mcqs;
}

<main class="dash-content">
    <div class="page-intro">
        <div>
            <h3>Final <span>Results</span></h3>
            <p>Certification exam results, grades, faculty remarks and individual MCQ answers.</p>
        </div>
    </div>
    <input type="radio" name="rtabs" id="tab1" class="rtabs-input" checked />
    <input type="radio" name="rtabs" id="tab2" class="rtabs-input" />
    <div class="rtabs-nav">
        <label for="tab1"><i class="bi bi-trophy"></i> Final Results</label>
        <label for="tab2"><i class="bi bi-list-check"></i> Final MCQ Answers</label>
    </div>
    <div class="rtabs-content">
        <div class="rtabs-panel" id="panel1">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-trophy"></i> All Final Results</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="finalResultsTable" placeholder="Search..." /></div>
                        <a href="#add-finalResultsTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="finalResultsTable">
                    <thead><tr><th>#</th><th>Student</th><th>Exam</th><th>Total Q.</th><th>Correct</th><th>Wrong</th><th>Marks</th><th>Percentage</th><th>Grade</th><th>Status</th><th>Date</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var r in results)
                        {
                            i++;
                            var gradeBadge = r.Grade == "A" ? "badge-green" : (r.Grade == "F" ? "badge-red" : "badge-gold");
                            var statusBadge = r.ResultStatus == "Pass" ? "badge-green" : "badge-red";
                            <tr>
                                <td>@i</td>
                                <td>@r.Student?.RollNumber — @r.Student?.User?.FullName</td>
                                <td>@r.FinalExam?.ExamTitle</td>
                                <td>@r.TotalQuestions</td>
                                <td>@r.CorrectAnswers</td>
                                <td>@r.WrongAnswers</td>
                                <td>@r.MarksObtained / @r.TotalMarks</td>
                                <td>@r.Percentage.ToString("0.#")%</td>
                                <td><span class="badge @gradeBadge">@r.Grade</span></td>
                                <td><span class="badge @statusBadge">@r.ResultStatus</span></td>
                                <td>@(r.ResultDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-finalResultsTable" class="icon-btn js-edit-fresult" title="Edit"
                                           data-id="@r.ResultId" data-studentid="@r.StudentId" data-examid="@r.FinalExamId"
                                           data-totalq="@r.TotalQuestions" data-totalmarks="@r.TotalMarks"
                                           data-correct="@r.CorrectAnswers" data-wrong="@r.WrongAnswers"
                                           data-obtained="@r.MarksObtained" data-percentage="@r.Percentage"
                                           data-grade="@r.Grade" data-status="@r.ResultStatus" data-remarks="@r.Remarks"
                                           data-date="@r.ResultDate?.ToString("yyyy-MM-dd")">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-fresult" title="Delete" data-id="@r.ResultId">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @results.Count of @results.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-finalResultsTable">
                <div class="css-modal-box wide">
                    <form id="add-fresult-form">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add Final Result</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Student</label>
                                <select class="form-control" name="StudentId" required>
                                    <option value="">-- Select Student --</option>
                                    @foreach (var s in students)
                                    {
                                        <option value="@s.StudentId">@s.RollNumber — @s.User?.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Final Exam</label>
                                <select class="form-control" name="FinalExamId" required>
                                    <option value="">-- Select Exam --</option>
                                    @foreach (var e in exams)
                                    {
                                        <option value="@e.FinalExamId">@e.ExamTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Total Questions</label>
                                    <input type="number" class="form-control" name="TotalQuestions" placeholder="e.g. 100" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Total Marks</label>
                                    <input type="number" class="form-control" name="TotalMarks" placeholder="e.g. 100" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Correct Answers</label>
                                    <input type="number" class="form-control" name="CorrectAnswers" placeholder="e.g. 85" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Wrong Answers</label>
                                    <input type="number" class="form-control" name="WrongAnswers" placeholder="e.g. 15" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Marks Obtained</label>
                                    <input type="number" class="form-control" name="MarksObtained" placeholder="e.g. 85" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Percentage (%)</label>
                                    <input type="number" step="0.01" class="form-control" name="Percentage" placeholder="e.g. 85" />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Grade</label>
                                    <input type="text" class="form-control" name="Grade" placeholder="e.g. A" />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Result Status</label>
                                    <select class="form-control" name="ResultStatus">
                                        <option value="Pass">Pass</option>
                                        <option value="Fail">Fail</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Remarks</label>
                                <textarea class="form-control" name="Remarks" rows="2" placeholder="Faculty remarks about the student's performance"></textarea>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Result Date</label>
                                <input type="date" class="form-control" name="ResultDate" />
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save Result</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-finalResultsTable">
                <div class="css-modal-box wide">
                    <form id="edit-fresult-form">
                        <input type="hidden" name="ResultId" id="edit-fresult-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit Final Result</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Student</label>
                                <select class="form-control" name="StudentId" id="edit-fresult-studentid" required>
                                    @foreach (var s in students)
                                    {
                                        <option value="@s.StudentId">@s.RollNumber — @s.User?.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Final Exam</label>
                                <select class="form-control" name="FinalExamId" id="edit-fresult-examid" required>
                                    @foreach (var e in exams)
                                    {
                                        <option value="@e.FinalExamId">@e.ExamTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Total Questions</label>
                                    <input type="number" class="form-control" name="TotalQuestions" id="edit-fresult-totalq" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Total Marks</label>
                                    <input type="number" class="form-control" name="TotalMarks" id="edit-fresult-totalmarks" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Correct Answers</label>
                                    <input type="number" class="form-control" name="CorrectAnswers" id="edit-fresult-correct" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Wrong Answers</label>
                                    <input type="number" class="form-control" name="WrongAnswers" id="edit-fresult-wrong" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Marks Obtained</label>
                                    <input type="number" class="form-control" name="MarksObtained" id="edit-fresult-obtained" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Percentage (%)</label>
                                    <input type="number" step="0.01" class="form-control" name="Percentage" id="edit-fresult-percentage" />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Grade</label>
                                    <input type="text" class="form-control" name="Grade" id="edit-fresult-grade" />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Result Status</label>
                                    <select class="form-control" name="ResultStatus" id="edit-fresult-status">
                                        <option value="Pass">Pass</option>
                                        <option value="Fail">Fail</option>
                                    </select>
                                </div>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Remarks</label>
                                <textarea class="form-control" name="Remarks" id="edit-fresult-remarks" rows="2"></textarea>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Result Date</label>
                                <input type="date" class="form-control" name="ResultDate" id="edit-fresult-date" />
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update Result</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="rtabs-panel" id="panel2">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-list-check"></i> Final MCQ Answers</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="finalMcqAnsTable" placeholder="Search..." /></div>
                        <a href="#add-finalMcqAnsTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="finalMcqAnsTable">
                    <thead><tr><th>#</th><th>Student</th><th>Exam</th><th>MCQ</th><th>Selected Option</th><th>Marks</th><th>Submitted At</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int ai = 0; }
                        @foreach (var a in answers)
                        {
                            ai++;
                            var optBadge = a.SelectedOption == a.Mcq?.CorrectOption ? "badge-gold" : "badge-red";
                            <tr>
                                <td>@ai</td>
                                <td>@a.Student?.RollNumber — @a.Student?.User?.FullName</td>
                                <td>@a.FinalExam?.ExamTitle</td>
                                <td>MCQ #@a.McqId</td>
                                <td><span class="badge @optBadge">@a.SelectedOption</span></td>
                                <td>@a.Marks</td>
                                <td>@(a.SubmittedAt?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-finalMcqAnsTable" class="icon-btn js-edit-fanswer" title="Edit"
                                           data-id="@a.AnswerId" data-studentid="@a.StudentId" data-examid="@a.FinalExamId"
                                           data-mcqid="@a.McqId" data-option="@a.SelectedOption" data-marks="@a.Marks"
                                           data-submitted="@a.SubmittedAt?.ToString("yyyy-MM-ddTHH:mm")">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-fanswer" title="Delete" data-id="@a.AnswerId">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @answers.Count of @answers.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-finalMcqAnsTable">
                <div class="css-modal-box wide">
                    <form id="add-fanswer-form">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add MCQ Answer</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Student</label>
                                <select class="form-control" name="StudentId" required>
                                    <option value="">-- Select Student --</option>
                                    @foreach (var s in students)
                                    {
                                        <option value="@s.StudentId">@s.RollNumber — @s.User?.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Final Exam</label>
                                <select class="form-control" name="FinalExamId" required>
                                    <option value="">-- Select Exam --</option>
                                    @foreach (var e in exams)
                                    {
                                        <option value="@e.FinalExamId">@e.ExamTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">MCQ</label>
                                    <select class="form-control" name="McqId" required>
                                        <option value="">-- Select MCQ --</option>
                                        @foreach (var m in mcqs)
                                        {
                                            <option value="@m.McqId">#@m.McqId — @m.FinalExam?.ExamTitle</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Selected Option</label>
                                    <select class="form-control" name="SelectedOption">
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Marks</label>
                                    <input type="number" class="form-control" name="Marks" placeholder="e.g. 1" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Submitted At</label>
                                    <input type="datetime-local" class="form-control" name="SubmittedAt" />
                                </div>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save Answer</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-finalMcqAnsTable">
                <div class="css-modal-box wide">
                    <form id="edit-fanswer-form">
                        <input type="hidden" name="AnswerId" id="edit-fanswer-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit MCQ Answer</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Student</label>
                                <select class="form-control" name="StudentId" id="edit-fanswer-studentid" required>
                                    @foreach (var s in students)
                                    {
                                        <option value="@s.StudentId">@s.RollNumber — @s.User?.FullName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Final Exam</label>
                                <select class="form-control" name="FinalExamId" id="edit-fanswer-examid" required>
                                    @foreach (var e in exams)
                                    {
                                        <option value="@e.FinalExamId">@e.ExamTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">MCQ</label>
                                    <select class="form-control" name="McqId" id="edit-fanswer-mcqid" required>
                                        @foreach (var m in mcqs)
                                        {
                                            <option value="@m.McqId">#@m.McqId — @m.FinalExam?.ExamTitle</option>
                                        }
                                    </select>
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Selected Option</label>
                                    <select class="form-control" name="SelectedOption" id="edit-fanswer-option">
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Marks</label>
                                    <input type="number" class="form-control" name="Marks" id="edit-fanswer-marks" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Submitted At</label>
                                    <input type="datetime-local" class="form-control" name="SubmittedAt" id="edit-fanswer-submitted" />
                                </div>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update Answer</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {

            // =================== RESULT ===================

            $('.js-edit-fresult').on('click', function () {
                $('#edit-fresult-id').val($(this).data('id'));
                $('#edit-fresult-studentid').val($(this).data('studentid'));
                $('#edit-fresult-examid').val($(this).data('examid'));
                $('#edit-fresult-totalq').val($(this).data('totalq'));
                $('#edit-fresult-totalmarks').val($(this).data('totalmarks'));
                $('#edit-fresult-correct').val($(this).data('correct'));
                $('#edit-fresult-wrong').val($(this).data('wrong'));
                $('#edit-fresult-obtained').val($(this).data('obtained'));
                $('#edit-fresult-percentage').val($(this).data('percentage') || '');
                $('#edit-fresult-grade').val($(this).data('grade') || '');
                $('#edit-fresult-status').val($(this).data('status'));
                $('#edit-fresult-remarks').val($(this).data('remarks') || '');
                $('#edit-fresult-date').val($(this).data('date') || '');
            });

            $('#add-fresult-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveResult", "FinalResults")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'Result added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-fresult-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveResult", "FinalResults")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'Result updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-fresult').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete this result? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteResult", "FinalResults")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Result has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

            // =================== ANSWER ===================

            $('.js-edit-fanswer').on('click', function () {
                $('#edit-fanswer-id').val($(this).data('id'));
                $('#edit-fanswer-studentid').val($(this).data('studentid'));
                $('#edit-fanswer-examid').val($(this).data('examid'));
                $('#edit-fanswer-mcqid').val($(this).data('mcqid'));
                $('#edit-fanswer-option').val($(this).data('option'));
                $('#edit-fanswer-marks').val($(this).data('marks'));
                $('#edit-fanswer-submitted').val($(this).data('submitted') || '');
            });

            $('#add-fanswer-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveAnswer", "FinalResults")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'Answer added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-fanswer-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveAnswer", "FinalResults")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'Answer updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-fanswer').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete this answer? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteAnswer", "FinalResults")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Answer has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

        });
    </script>
}
