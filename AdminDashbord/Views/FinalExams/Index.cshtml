@{
    var exams = (List<AdminDashbord.Models.FinalExam>)ViewBag.Exams;
    var mcqs = (List<AdminDashbord.Models.FinalMcq>)ViewBag.Mcqs;
    var courses = (List<AdminDashbord.Models.Course>)ViewBag.Courses;
    var topics = (List<AdminDashbord.Models.CourseTopic>)ViewBag.Topics;
}

<main class="dash-content">
    <div class="page-intro">
        <div>
            <h3>Final <span>Exams &amp; MCQs</span></h3>
            <p>Manage course completion certification exams and their MCQ question bank.</p>
        </div>
    </div>
    <input type="radio" name="rtabs" id="tab1" class="rtabs-input" checked />
    <input type="radio" name="rtabs" id="tab2" class="rtabs-input" />
    <div class="rtabs-nav">
        <label for="tab1"><i class="bi bi-file-earmark-text"></i> Final Exams</label>
        <label for="tab2"><i class="bi bi-patch-question"></i> Final MCQs</label>
    </div>
    <div class="rtabs-content">
        <div class="rtabs-panel" id="panel1">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-file-earmark-text"></i> All Final Exams</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="finalExamsTable" placeholder="Search..." /></div>
                        <a href="#add-finalExamsTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="finalExamsTable">
                    <thead><tr><th>#</th><th>Course</th><th>Exam Title</th><th>Exam Date</th><th>Total Marks</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int i = 0; }
                        @foreach (var e in exams)
                        {
                            i++;
                            <tr>
                                <td>@i</td>
                                <td>@e.Course?.CourseName</td>
                                <td>@e.ExamTitle</td>
                                <td>@(e.ExamDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                <td>@e.TotalMarks</td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-finalExamsTable" class="icon-btn js-edit-fexam" title="Edit"
                                           data-id="@e.FinalExamId" data-courseid="@e.CourseId" data-title="@e.ExamTitle"
                                           data-date="@e.ExamDate?.ToString("yyyy-MM-dd")" data-marks="@e.TotalMarks">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-fexam" title="Delete" data-id="@e.FinalExamId">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @exams.Count of @exams.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-finalExamsTable">
                <div class="css-modal-box">
                    <form id="add-fexam-form">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add New Final Exam</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Course</label>
                                <select class="form-control" name="CourseId" required>
                                    <option value="">-- Select Course --</option>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId">@c.CourseName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Exam Title</label>
                                <input type="text" class="form-control" name="ExamTitle" placeholder="e.g. Web Development Final Certification Exam" required />
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Exam Date</label>
                                    <input type="date" class="form-control" name="ExamDate" />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Total Marks</label>
                                    <input type="number" class="form-control" name="TotalMarks" placeholder="e.g. 100" required />
                                </div>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save Exam</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-finalExamsTable">
                <div class="css-modal-box">
                    <form id="edit-fexam-form">
                        <input type="hidden" name="FinalExamId" id="edit-fexam-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit Final Exam</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Course</label>
                                <select class="form-control" name="CourseId" id="edit-fexam-courseid" required>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId">@c.CourseName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Exam Title</label>
                                <input type="text" class="form-control" name="ExamTitle" id="edit-fexam-title" required />
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Exam Date</label>
                                    <input type="date" class="form-control" name="ExamDate" id="edit-fexam-date" />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Total Marks</label>
                                    <input type="number" class="form-control" name="TotalMarks" id="edit-fexam-marks" required />
                                </div>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update Exam</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="rtabs-panel" id="panel2">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-patch-question"></i> All Final MCQs</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="finalMcqsTable" placeholder="Search..." /></div>
                        <a href="#add-finalMcqsTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="finalMcqsTable">
                    <thead><tr><th>#</th><th>Exam</th><th>Topic</th><th>Question</th><th>Correct Option</th><th>Marks</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int mi = 0; }
                        @foreach (var m in mcqs)
                        {
                            mi++;
                            <tr>
                                <td>@mi</td>
                                <td>@m.FinalExam?.ExamTitle</td>
                                <td>@(m.Topic?.TopicName ?? "—")</td>
                                <td>@m.QuestionText</td>
                                <td><span class="badge badge-gold">@m.CorrectOption</span></td>
                                <td>@m.McqMarks</td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-finalMcqsTable" class="icon-btn js-edit-fmcq" title="Edit"
                                           data-id="@m.McqId" data-examid="@m.FinalExamId" data-topicid="@m.TopicId"
                                           data-question="@m.QuestionText" data-a="@m.OptionA" data-b="@m.OptionB"
                                           data-c="@m.OptionC" data-d="@m.OptionD" data-correct="@m.CorrectOption" data-marks="@m.McqMarks">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-fmcq" title="Delete" data-id="@m.McqId">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @mcqs.Count of @mcqs.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-finalMcqsTable">
                <div class="css-modal-box wide">
                    <form id="add-fmcq-form">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add New MCQ</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Final Exam</label>
                                <select class="form-control" name="FinalExamId" required>
                                    <option value="">-- Select Exam --</option>
                                    @foreach (var e in exams)
                                    {
                                        <option value="@e.FinalExamId">@e.ExamTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Topic</label>
                                <select class="form-control" name="TopicId">
                                    <option value="">-- Select Topic --</option>
                                    @foreach (var t in topics)
                                    {
                                        <option value="@t.TopicId">@t.TopicName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Question Text</label>
                                <textarea class="form-control" name="QuestionText" rows="2" placeholder="Type the MCQ question here" required></textarea>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Option A</label>
                                    <input type="text" class="form-control" name="OptionA" placeholder="Option A" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Option B</label>
                                    <input type="text" class="form-control" name="OptionB" placeholder="Option B" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Option C</label>
                                    <input type="text" class="form-control" name="OptionC" placeholder="Option C" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Option D</label>
                                    <input type="text" class="form-control" name="OptionD" placeholder="Option D" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Correct Option</label>
                                    <select class="form-control" name="CorrectOption">
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">MCQ Marks</label>
                                    <input type="number" class="form-control" name="McqMarks" placeholder="e.g. 1" value="1" required />
                                </div>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save MCQ</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-finalMcqsTable">
                <div class="css-modal-box wide">
                    <form id="edit-fmcq-form">
                        <input type="hidden" name="McqId" id="edit-fmcq-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit MCQ</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Final Exam</label>
                                <select class="form-control" name="FinalExamId" id="edit-fmcq-examid" required>
                                    @foreach (var e in exams)
                                    {
                                        <option value="@e.FinalExamId">@e.ExamTitle</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Topic</label>
                                <select class="form-control" name="TopicId" id="edit-fmcq-topicid">
                                    <option value="">-- Select Topic --</option>
                                    @foreach (var t in topics)
                                    {
                                        <option value="@t.TopicId">@t.TopicName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Question Text</label>
                                <textarea class="form-control" name="QuestionText" id="edit-fmcq-question" rows="2" required></textarea>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Option A</label>
                                    <input type="text" class="form-control" name="OptionA" id="edit-fmcq-a" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Option B</label>
                                    <input type="text" class="form-control" name="OptionB" id="edit-fmcq-b" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Option C</label>
                                    <input type="text" class="form-control" name="OptionC" id="edit-fmcq-c" required />
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">Option D</label>
                                    <input type="text" class="form-control" name="OptionD" id="edit-fmcq-d" required />
                                </div>
                            </div>
                            <div class="modal-grid-2">
                                <div class="form-group ">
                                    <label class="form-label">Correct Option</label>
                                    <select class="form-control" name="CorrectOption" id="edit-fmcq-correct">
                                        <option value="A">A</option>
                                        <option value="B">B</option>
                                        <option value="C">C</option>
                                        <option value="D">D</option>
                                    </select>
                                </div>
                                <div class="form-group ">
                                    <label class="form-label">MCQ Marks</label>
                                    <input type="number" class="form-control" name="McqMarks" id="edit-fmcq-marks" required />
                                </div>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update MCQ</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {

            // =================== EXAM ===================

            $('.js-edit-fexam').on('click', function () {
                $('#edit-fexam-id').val($(this).data('id'));
                $('#edit-fexam-courseid').val($(this).data('courseid'));
                $('#edit-fexam-title').val($(this).data('title'));
                $('#edit-fexam-date').val($(this).data('date') || '');
                $('#edit-fexam-marks').val($(this).data('marks'));
            });

            $('#add-fexam-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveExam", "FinalExams")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'Exam added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-fexam-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveExam", "FinalExams")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'Exam updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-fexam').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete this final exam? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteExam", "FinalExams")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Exam has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

            // =================== MCQ ===================

            $('.js-edit-fmcq').on('click', function () {
                $('#edit-fmcq-id').val($(this).data('id'));
                $('#edit-fmcq-examid').val($(this).data('examid'));
                $('#edit-fmcq-topicid').val($(this).data('topicid') || '');
                $('#edit-fmcq-question').val($(this).data('question'));
                $('#edit-fmcq-a').val($(this).data('a'));
                $('#edit-fmcq-b').val($(this).data('b'));
                $('#edit-fmcq-c').val($(this).data('c'));
                $('#edit-fmcq-d').val($(this).data('d'));
                $('#edit-fmcq-correct').val($(this).data('correct'));
                $('#edit-fmcq-marks').val($(this).data('marks'));
            });

            $('#add-fmcq-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveMcq", "FinalExams")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'MCQ added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-fmcq-form').on('submit', function (e) {
                e.preventDefault();
                $.ajax({
                    url: '@Url.Action("SaveMcq", "FinalExams")',
                    type: 'POST',
                    data: $(this).serialize(),
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'MCQ updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-fmcq').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete this MCQ? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteMcq", "FinalExams")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'MCQ has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

        });
    </script>
}
