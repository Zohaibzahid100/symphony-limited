@{
    var courses = (List<AdminDashbord.Models.Course>)ViewBag.Courses;
    var tracks = (List<AdminDashbord.Models.CourseTrack>)ViewBag.Tracks;
    var topics = (List<AdminDashbord.Models.CourseTopic>)ViewBag.Topics;
}

<main class="dash-content">
    <div class="page-intro">
        <div>
            <h3>Courses <span>&amp; Tracks</span></h3>
            <p>Manage courses, their Basic/Advanced tracks, and topics covered in each track.</p>
        </div>
    </div>
    <input type="radio" name="rtabs" id="tab1" class="rtabs-input" checked />
    <input type="radio" name="rtabs" id="tab2" class="rtabs-input" />
    <input type="radio" name="rtabs" id="tab3" class="rtabs-input" />
    <div class="rtabs-nav">
        <label for="tab1"><i class="bi bi-collection"></i> Courses</label>
        <label for="tab2"><i class="bi bi-diagram-2"></i> Course Tracks</label>
        <label for="tab3"><i class="bi bi-list-task"></i> Course Topics</label>
    </div>
    <div class="rtabs-content">

        <!-- ================= COURSES PANEL ================= -->
        <div class="rtabs-panel" id="panel1">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-collection"></i> All Courses</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="coursesTable" placeholder="Search..." /></div>
                        <a href="#add-coursesTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="coursesTable">
                    <thead><tr><th>#</th><th>Course</th><th>Description</th><th>Status</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int ci = 0; }
                        @foreach (var c in courses)
                        {
                            ci++;
                            var trackCount = tracks.Count(t => t.CourseId == c.CourseId);
                            var badgeClass = c.CourseStatus == "Available" ? "badge-green" : "badge-red";
                            var imgSrc = string.IsNullOrEmpty(c.CourseImg) ? "~/assets/images/page-cover.svg" : $"~/uploads/courses/{c.CourseImg}";
                            <tr>
                                <td>@ci</td>
                                <td>
                                    <div class="table-cell-main">
                                        <img src="@Url.Content(imgSrc)" alt="" class="table-thumb" />
                                        <div>
                                            <strong>@c.CourseName</strong><br />
                                            <span class="table-cell-sub">@trackCount track@(trackCount == 1 ? "" : "s")</span>
                                        </div>
                                    </div>
                                </td>
                                <td>@(c.Description ?? "—")</td>
                                <td><span class="badge @badgeClass">@c.CourseStatus</span></td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-coursesTable" class="icon-btn js-edit-course" title="Edit"
                                           data-id="@c.CourseId" data-name="@c.CourseName" data-desc="@c.Description" data-status="@c.CourseStatus">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-course" title="Delete" data-id="@c.CourseId" data-name="@c.CourseName">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @courses.Count of @courses.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-coursesTable">
                <div class="css-modal-box">
                    <form id="add-course-form" enctype="multipart/form-data">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add New Course</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Course Name</label>
                                <input type="text" class="form-control" name="CourseName" placeholder="e.g. Web Development" required />
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Course Image</label>
                                <input type="file" class="form-control" name="CourseImageFile" accept="image/*" required />
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="Description" rows="3" placeholder="Short description of the course"></textarea>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Course Status</label>
                                <select class="form-control" name="CourseStatus">
                                    <option value="Available">Available</option>
                                    <option value="Not Available">Not Available</option>
                                </select>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save Course</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-coursesTable">
                <div class="css-modal-box">
                    <form id="edit-course-form" enctype="multipart/form-data">
                        <input type="hidden" name="CourseId" id="edit-course-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit Course</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Course Name</label>
                                <input type="text" class="form-control" name="CourseName" id="edit-course-name" required />
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Course Image <span class="table-cell-sub">(leave empty to keep current)</span></label>
                                <input type="file" class="form-control" name="CourseImageFile" accept="image/*" />
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Description</label>
                                <textarea class="form-control" name="Description" id="edit-course-desc" rows="3"></textarea>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Course Status</label>
                                <select class="form-control" name="CourseStatus" id="edit-course-status">
                                    <option value="Available">Available</option>
                                    <option value="Not Available">Not Available</option>
                                </select>
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update Course</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= TRACKS PANEL ================= -->
        <div class="rtabs-panel" id="panel2">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-diagram-2"></i> All Course Tracks</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="tracksTable" placeholder="Search..." /></div>
                        <a href="#add-tracksTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="tracksTable">
                    <thead><tr><th>#</th><th>Course</th><th>Track Name</th><th>Duration</th><th>Course Fee</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int ti = 0; }
                        @foreach (var t in tracks)
                        {
                            ti++;
                            var badgeClass = t.TrackName.Contains("Advanced") ? "badge-blue" : "badge-gold";
                            <tr>
                                <td>@ti</td>
                                <td>@t.Course?.CourseName</td>
                                <td><span class="badge @badgeClass">@t.TrackName</span></td>
                                <td>@t.DurationMonths months</td>
                                <td>PKR @t.CourseFee.ToString("N0")</td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-tracksTable" class="icon-btn js-edit-track" title="Edit"
                                           data-id="@t.TrackId" data-courseid="@t.CourseId" data-name="@t.TrackName"
                                           data-duration="@t.DurationMonths" data-fee="@t.CourseFee">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-track" title="Delete" data-id="@t.TrackId" data-name="@t.TrackName">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @tracks.Count of @tracks.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-tracksTable">
                <div class="css-modal-box">
                    <form id="add-track-form">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add New Track</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Course</label>
                                <select class="form-control" name="CourseId" required>
                                    <option value="">-- Select Course --</option>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId">@c.CourseName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Track Name</label>
                                <select class="form-control" name="TrackName">
                                    <option value="Basic">Basic</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Duration (Months)</label>
                                <input type="number" class="form-control" name="DurationMonths" placeholder="e.g. 3" required />
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Course Fee (PKR)</label>
                                <input type="number" step="0.01" class="form-control" name="CourseFee" placeholder="e.g. 12000" required />
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save Track</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-tracksTable">
                <div class="css-modal-box">
                    <form id="edit-track-form">
                        <input type="hidden" name="TrackId" id="edit-track-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit Track</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Course</label>
                                <select class="form-control" name="CourseId" id="edit-track-courseid" required>
                                    @foreach (var c in courses)
                                    {
                                        <option value="@c.CourseId">@c.CourseName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Track Name</label>
                                <select class="form-control" name="TrackName" id="edit-track-name">
                                    <option value="Basic">Basic</option>
                                    <option value="Advanced">Advanced</option>
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Duration (Months)</label>
                                <input type="number" class="form-control" name="DurationMonths" id="edit-track-duration" required />
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Course Fee (PKR)</label>
                                <input type="number" step="0.01" class="form-control" name="CourseFee" id="edit-track-fee" required />
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update Track</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- ================= TOPICS PANEL ================= -->
        <div class="rtabs-panel" id="panel3">
            <div class="table-wrapper">
                <div class="table-toolbar">
                    <h4><i class="bi bi-list-task"></i> All Course Topics</h4>
                    <div class="toolbar-actions">
                        <div class="search-box"><i class="bi bi-search"></i><input type="text" data-table-search="topicsTable" placeholder="Search..." /></div>
                        <a href="#add-topicsTable" class="btn btn-gold btn-sm"><i class="bi bi-plus-lg"></i> Add New</a>
                    </div>
                </div>
                <table id="topicsTable">
                    <thead><tr><th>#</th><th>Track</th><th>Topic Name</th><th>Actions</th></tr></thead>
                    <tbody>
                        @{ int pi = 0; }
                        @foreach (var p in topics)
                        {
                            pi++;
                            var trackLabel = $"{p.Track?.Course?.CourseName} — {p.Track?.TrackName}";
                            <tr>
                                <td>@pi</td>
                                <td>@trackLabel</td>
                                <td>@p.TopicName</td>
                                <td>
                                    <div class="row-actions">
                                        <a href="#edit-topicsTable" class="icon-btn js-edit-topic" title="Edit"
                                           data-id="@p.TopicId" data-trackid="@p.TrackId" data-name="@p.TopicName">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a href="#" class="icon-btn danger js-delete-topic" title="Delete" data-id="@p.TopicId" data-name="@p.TopicName">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="table-footer"><span>Showing @topics.Count of @topics.Count entries</span></div>
            </div>

            <div class="css-modal" id="add-topicsTable">
                <div class="css-modal-box">
                    <form id="add-topic-form">
                        <div class="css-modal-header">
                            <h4><i class="bi bi-plus-circle"></i> Add New Topic</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Track</label>
                                <select class="form-control" name="TrackId" required>
                                    <option value="">-- Select Track --</option>
                                    @foreach (var t in tracks)
                                    {
                                        <option value="@t.TrackId">@t.Course?.CourseName — @t.TrackName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Topic Name</label>
                                <input type="text" class="form-control" name="TopicName" placeholder="e.g. HTML &amp; CSS" required />
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Save Topic</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="css-modal" id="edit-topicsTable">
                <div class="css-modal-box">
                    <form id="edit-topic-form">
                        <input type="hidden" name="TopicId" id="edit-topic-id" />
                        <div class="css-modal-header">
                            <h4><i class="bi bi-pencil-square"></i> Edit Topic</h4>
                            <a href="#" class="css-modal-close"><i class="bi bi-x-lg"></i></a>
                        </div>
                        <div class="css-modal-body">
                            <div class="form-group ">
                                <label class="form-label">Track</label>
                                <select class="form-control" name="TrackId" id="edit-topic-trackid" required>
                                    @foreach (var t in tracks)
                                    {
                                        <option value="@t.TrackId">@t.Course?.CourseName — @t.TrackName</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group ">
                                <label class="form-label">Topic Name</label>
                                <input type="text" class="form-control" name="TopicName" id="edit-topic-name" required />
                            </div>
                        </div>
                        <div class="css-modal-footer">
                            <a href="#" class="btn btn-ghost btn-sm">Cancel</a>
                            <button type="submit" class="btn btn-gold btn-sm"><i class="bi bi-check-lg"></i> Update Topic</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>

</main>

@section Scripts {
    <script>
        $(document).ready(function () {

            // =================== COURSE ===================

            $('.js-edit-course').on('click', function () {
                $('#edit-course-id').val($(this).data('id'));
                $('#edit-course-name').val($(this).data('name'));
                $('#edit-course-desc').val($(this).data('desc') || '');
                $('#edit-course-status').val($(this).data('status'));
            });

            $('#add-course-form').on('submit', function (e) {
                e.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: '@Url.Action("SaveCourse", "Courses")',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'Course added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-course-form').on('submit', function (e) {
                e.preventDefault();
                var formData = new FormData(this);
                $.ajax({
                    url: '@Url.Action("SaveCourse", "Courses")',
                    type: 'POST',
                    data: formData,
                    contentType: false,
                    processData: false,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'Course updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-course').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var name = $(this).data('name');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete course "' + name + '"? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteCourse", "Courses")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Course has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

            // =================== TRACK ===================

            $('.js-edit-track').on('click', function () {
                $('#edit-track-id').val($(this).data('id'));
                $('#edit-track-courseid').val($(this).data('courseid'));
                $('#edit-track-name').val($(this).data('name'));
                $('#edit-track-duration').val($(this).data('duration'));
                $('#edit-track-fee').val($(this).data('fee'));
            });

            $('#add-track-form').on('submit', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                $.ajax({
                    url: '@Url.Action("SaveTrack", "Courses")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'Track added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-track-form').on('submit', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                $.ajax({
                    url: '@Url.Action("SaveTrack", "Courses")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'Track updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-track').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var name = $(this).data('name');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete track "' + name + '"? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteTrack", "Courses")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Track has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

            // =================== TOPIC ===================

            $('.js-edit-topic').on('click', function () {
                $('#edit-topic-id').val($(this).data('id'));
                $('#edit-topic-trackid').val($(this).data('trackid'));
                $('#edit-topic-name').val($(this).data('name'));
            });

            $('#add-topic-form').on('submit', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                $.ajax({
                    url: '@Url.Action("SaveTopic", "Courses")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Saved!', 'Topic added successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('#edit-topic-form').on('submit', function (e) {
                e.preventDefault();
                var formData = $(this).serialize();
                $.ajax({
                    url: '@Url.Action("SaveTopic", "Courses")',
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Updated!', 'Topic updated successfully.', 'success').then(function () { location.reload(); });
                        } else {
                            Swal.fire('Error', response.message, 'error');
                        }
                    },
                    error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                });
            });

            $('.js-delete-topic').on('click', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var name = $(this).data('name');
                Swal.fire({
                    title: 'Are you sure?',
                    text: 'Delete topic "' + name + '"? This cannot be undone.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it',
                    cancelButtonText: 'Cancel'
                }).then(function (result) {
                    if (result.isConfirmed) {
                        $.ajax({
                            url: '@Url.Action("DeleteTopic", "Courses")/' + id,
                            type: 'POST',
                            success: function (response) {
                                if (response.success) {
                                    Swal.fire('Deleted!', 'Topic has been deleted.', 'success').then(function () { location.reload(); });
                                } else {
                                    Swal.fire('Error', response.message, 'error');
                                }
                            },
                            error: function () { Swal.fire('Error', 'Something went wrong. Please try again.', 'error'); }
                        });
                    }
                });
            });

        });
    </script>
}
