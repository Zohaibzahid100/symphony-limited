@{
    ViewData["Title"] = "Entrance Exams";
}


<!-- PAGE HERO -->
<div class="page-hero">
    <div class="container text-center">
        <div class="breadcrumb"><a href="../index.html">Home</a><i class="bi bi-chevron-right"></i><span>Entrance Exams</span></div>
        <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-pencil-square"></i> Admissions</div>
        <h1>Entrance <span style="color:var(--gold);">Examinations</span></h1>
        <p style="max-width:560px;margin:12px auto 0;color:var(--text-secondary);">Apply before the last date, pay the entrance fee, and take your MCQ test. Your score decides your track.</p>
    </div>
</div>

<!-- HOW IT WORKS STEPS -->
<section style="padding:56px 0;background:var(--bg-card);border-bottom:1px solid var(--border-light);">
    <div class="container text-center">
        <div class="steps-grid">
            <div class="step-item @(ViewBag.IsRegistered ? "active" : "")"><div class="step-num">1</div><h5>Register Online</h5><p style="font-size:.83rem;">Login to student portal and apply for the exam of your desired course.</p></div>
            <div class="step-item @(ViewBag.HasApplied ? "active" : "")"><div class="step-num">2</div><h5>Pay Entrance Fee</h5><p style="font-size:.83rem;">Pay PKR 500 entrance fee at your selected branch (Cash/Cheque/Draft).</p></div>
            <div class="step-item"><div class="step-num">3</div><h5>Appear in Test</h5><p style="font-size:.83rem;">Bring roll slip and appear on the scheduled exam date at your branch.</p></div>
            <div class="step-item"><div class="step-num">4</div><h5>Track Assigned</h5><p style="font-size:.83rem;">Results are declared and your track (Basic/Advanced) is assigned automatically.</p></div>
        </div>
    </div>
</section>

<!-- TRACK INFO STRIP -->
<section style="padding:28px 0;background:var(--bg-dark);border-bottom:1px solid var(--border-light);">
    <div class="container">
        <div style="display:flex;align-items:center;justify-content:center;gap:40px;flex-wrap:wrap;">
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:44px;height:44px;border-radius:8px;background:rgba(78,170,255,.1);border:1px solid rgba(78,170,255,.2);display:flex;align-items:center;justify-content:center;color:var(--info);"><i class="bi bi-star"></i></div>
                <div><strong style="color:var(--info);">Basic Track (DISM)</strong><div style="font-size:.78rem;color:var(--text-muted);">Score 0 – 49%</div></div>
            </div>
            <div style="width:1px;height:40px;background:var(--border-light);"></div>
            <div style="display:flex;align-items:center;gap:12px;">
                <div style="width:44px;height:44px;border-radius:8px;background:var(--gold-dim);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--gold);"><i class="bi bi-star-fill"></i></div>
                <div><strong style="color:var(--gold);">Advanced Track (CPISM)</strong><div style="font-size:.78rem;color:var(--text-muted);">Score 50 – 100%</div></div>
            </div>
            <div style="width:1px;height:40px;background:var(--border-light);"></div>
            <div style="display:flex;align-items:center;gap:10px;">
                <i class="bi bi-currency-rupee" style="color:var(--gold);font-size:1.2rem;"></i>
                <div><strong style="color:var(--text-primary);">Entrance Fee: PKR 500</strong><div style="font-size:.78rem;color:var(--text-muted);">Per exam, all courses</div></div>
            </div>
        </div>
    </div>
</section>

<!-- EXAMS LIST -->
<section class="section">
    <div class="container">
        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:32px;flex-wrap:wrap;gap:12px;">
            <h2>All <span style="color:var(--gold);">Exam Schedules</span></h2>
            <button onclick="startDemoExam()" class="btn btn-outline"><i class="bi bi-play-circle"></i> Try Demo Exam</button>
        </div>

        @{ var appliedIds = (List<int>)ViewBag.AppliedExamIds; }
        @foreach (var exam in (List<EntranceExam>)ViewBag.Exams)
        {
            bool isCompleted = exam.ExamStatus == "Completed";
            bool alreadyApplied = appliedIds.Contains(exam.EntranceExamId);
            <div class="exam-card" style="margin-bottom:16px;">
                <div>
                    <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px;">
                        <span class="badge @(isCompleted ? "badge-gold" : "badge-blue")">@exam.ExamStatus</span>
                        <span class="badge badge-gold">@exam.Course?.CourseName</span>
                    </div>
                    <h3 style="font-size:1.05rem;margin-bottom:6px;">@exam.ExamTitle</h3>
                    <div class="exam-meta">
                        <span class="exam-meta-item"><i class="bi bi-calendar3"></i>Exam: @exam.ExamDate.ToString("dd MMM yyyy")</span>
                        <span class="exam-meta-item"><i class="bi bi-hourglass-split"></i>Last Date: @(exam.LastDateToApply?.ToString("dd MMM yyyy") ?? "—")</span>
                        <span class="exam-meta-item"><i class="bi bi-currency-dollar"></i>PKR @exam.ExamFee.ToString("N0")</span>
                        <span class="exam-meta-item"><i class="bi bi-list-check"></i>@exam.TotalMarks MCQs</span>
                    </div>
                    @if (!isCompleted)
                    {
                        <div style="margin-top:14px;padding:11px 14px;background:var(--bg-card2);border-radius:var(--radius-sm);font-size:.8rem;color:var(--text-muted);">
                            <i class="bi bi-info-circle" style="color:var(--gold);margin-right:5px;"></i>
                            Score <strong style="color:var(--text-primary);">0–49%</strong> → Basic &nbsp;|&nbsp;
                            Score <strong style="color:var(--gold);">50–100%</strong> → Advanced
                        </div>
                    }
                </div>
                <div style="flex-shrink:0;display:flex;flex-direction:column;gap:10px;align-items:flex-end;">
                    @if (isCompleted)
                    {
                        <span style="font-size:.8rem;color:var(--text-muted);text-align:right;">Exam Completed</span>
                    }
                    else if (alreadyApplied)
                    {
                        <span class="badge badge-green"><i class="bi bi-check2"></i> Applied</span>
                        <a asp-controller="EntranceExam" asp-action="TakeExam" asp-route-examId="@exam.EntranceExamId" class="btn btn-gold btn-sm"><i class="bi bi-pencil-square"></i> Take Exam</a>
                    }
                    else if (ViewBag.IsRegistered)
                    {
                        <button onclick="applyExam(@exam.EntranceExamId,'@Html.Raw(exam.ExamTitle.Replace("'", "\\'"))','@exam.ExamDate.ToString("dd MMM yyyy")',@exam.ExamFee)" class="btn btn-gold">Apply Now <i class="bi bi-arrow-right"></i></button>
                        <button onclick="startDemoExam()" class="btn btn-outline btn-sm"><i class="bi bi-play-circle"></i> Demo Exam</button>
                    }
                    else
                    {
                        <a asp-controller="signin" asp-action="login" class="btn btn-outline" title="Register first to apply">Login to Apply</a>
                        <button onclick="startDemoExam()" class="btn btn-outline btn-sm"><i class="bi bi-play-circle"></i> Demo Exam</button>
                    }
                </div>
            </div>
        }

    </div>
</section>

<!-- FAQ STRIP -->
<section class="section-sm" style="background:var(--bg-card);border-top:1px solid var(--border-light);">
    <div class="container">
        <div class="grid-2" style="gap:56px;align-items:start;">
            <div>
                <div class="section-tag"><i class="bi bi-question-circle"></i> Exam FAQs</div>
                <h2 class="section-title">Common <span>Questions</span></h2>
                <div class="divider"></div>
                <ul class="about-list">
                    <li><i class="bi bi-check-circle-fill"></i><span>Bring your roll number printout on exam day.</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Each MCQ carries 1 mark, no negative marking.</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Results declared same day after exam completion.</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Track is assigned automatically — no manual review.</span></li>
                </ul>
                <a asp-action="Contact" asp-controller="contact" class="btn btn-outline" style="margin-top:16px;"><i class="bi bi-envelope"></i> Ask a Question</a>
            </div>
            <div style="display:flex;flex-direction:column;gap:12px;">
                <div style="background:var(--bg-card2);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:20px;">
                    <strong style="color:var(--text-primary);display:block;margin-bottom:6px;">Can I retake the exam?</strong>
                    <p style="font-size:.875rem;margin:0;">Yes, you can apply for the next batch's exam. A new entrance fee applies.</p>
                </div>
                <div style="background:var(--bg-card2);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:20px;">
                    <strong style="color:var(--text-primary);display:block;margin-bottom:6px;">What ID should I bring?</strong>
                    <p style="font-size:.875rem;margin:0;">Bring your CNIC or B-Form along with your exam roll slip.</p>
                </div>
                <div style="background:var(--bg-card2);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:20px;">
                    <strong style="color:var(--text-primary);display:block;margin-bottom:6px;">Is there a passing score?</strong>
                    <p style="font-size:.875rem;margin:0;">There is no fail in the entrance exam — your score only determines which track you enter.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- APPLY MODAL -->
<div class="modal-overlay" id="applyModal">
    <div class="modal-box">
        <div class="modal-header">
            <h4 id="applyModalTitle">Apply for Exam</h4>
            <button class="modal-close" onclick="closeModal('applyModal')"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body" id="applyModalBody"></div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('applyModal')">Cancel</button>
            <button class="btn btn-gold" id="confirmApplyBtn">Confirm Application <i class="bi bi-check2"></i></button>
        </div>
    </div>
</div>

<!-- DEMO EXAM MODAL -->
<div class="modal-overlay" id="examModal">
    <div class="modal-box" style="max-width:700px;">
        <div class="modal-header">
            <h4><i class="bi bi-pencil-square" style="color:var(--gold);margin-right:8px;"></i>Demo Entrance Exam</h4>
            <button class="modal-close" onclick="closeModal('examModal')"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body quiz-wrapper" id="quizContent"></div>
    </div>
</div>
<script>
    var branches = [
    @foreach (var branch in ViewBag.Branches)
    {
            <text>
                {
                    id: @branch.BranchId,
                    name: "@branch.BranchName"
                },
            </text>
    }
    ];
</script>
