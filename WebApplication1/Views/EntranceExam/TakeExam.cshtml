@using WebApplication1.Models
@{
    ViewData["Title"] = "Take Entrance Exam";
    var exam = (EntranceExam)ViewBag.Exam;
    var mcqs = (List<EntranceMcq>)ViewBag.Mcqs;
}

<div class="page-hero">
    <div class="container text-center">
        <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-pencil-square"></i> Entrance Exam</div>
        <h1>@exam.ExamTitle</h1>
        <p style="max-width:560px;margin:12px auto 0;color:var(--text-secondary);">@exam.Course?.CourseName &bull; @mcqs.Count Questions &bull; @exam.TotalMarks Marks</p>
    </div>
</div>

<section class="section">
    <div class="container" style="max-width:760px;">

        @if (!mcqs.Any())
        {
            <div class="table-wrapper" style="padding:24px;text-align:center;color:var(--text-muted);">
                No MCQs have been added for this exam yet. Please check back later or contact your branch.
            </div>
        }
        else
        {
            <form id="examForm" onsubmit="return false;">
                <input type="hidden" id="examId" value="@exam.EntranceExamId" />
                @{ int qn = 0; }
                @foreach (var m in mcqs)
                {
                    qn++;
                    <div class="quiz-card" style="margin-bottom:18px;">
                        <div class="quiz-question-text">
                            <span style="color:var(--gold);font-family:var(--font-display);font-size:1.1rem;margin-right:8px;">Q@(qn).</span>@m.QuestionText
                        </div>
                        <div class="quiz-options" data-mcq="@m.McqId">
                            @foreach (var opt in new[] { ("A", m.OptionA), ("B", m.OptionB), ("C", m.OptionC), ("D", m.OptionD) })
                            {
                                <label class="quiz-option" style="cursor:pointer;">
                                    <input type="radio" name="mcq_@m.McqId" value="@opt.Item1" style="margin-right:10px;" />
                                    <div class="option-letter">@opt.Item1</div>
                                    <span>@opt.Item2</span>
                                </label>
                            }
                        </div>
                    </div>
                }

                <button type="button" id="submitExamBtn" class="btn btn-gold btn-full" onclick="submitEntranceExam()">
                    Submit Exam <i class="bi bi-check2"></i>
                </button>
            </form>

            <div id="resultBox" style="display:none;margin-top:28px;" class="table-wrapper">
                <div class="table-header"><h4>Result</h4></div>
                <div style="padding:24px;text-align:center;" id="resultContent"></div>
            </div>
        }
    </div>
</section>

<div id="toastContainer" class="toast-container"></div>

<script>
    function submitEntranceExam() {
        const examId = document.getElementById('examId').value;
        const answers = {};
        document.querySelectorAll('[data-mcq]').forEach(group => {
            const mcqId = group.dataset.mcq;
            const checked = group.querySelector('input[type=radio]:checked');
            answers[mcqId] = checked ? checked.value : '';
        });

        const btn = document.getElementById('submitExamBtn');
        btn.disabled = true; btn.textContent = 'Submitting...';

        const body = { examId: parseInt(examId), answers };

        fetch('/EntranceExam/SubmitExam', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        })
        .then(r => r.json())
        .then(data => {
            if (!data.success) {
                alert(data.message || 'Could not submit exam.');
                btn.disabled = false; btn.textContent = 'Submit Exam';
                return;
            }
            document.getElementById('examForm').style.display = 'none';
            const box = document.getElementById('resultBox');
            const content = document.getElementById('resultContent');
            content.innerHTML = `
                <i class="bi bi-check-circle" style="font-size:2.2rem;color:var(--gold);display:block;margin-bottom:10px;"></i>
                <h3 style="margin-bottom:8px;">Exam Submitted Successfully</h3>
                <p style="color:var(--text-secondary);">
                    ${data.announcementDate
                        ? `Your result will be announced on <strong style="color:var(--gold);">${data.announcementDate}</strong>. Check the Results tab on that date.`
                        : `Your result will appear on the Results tab shortly.`}
                </p>
                <a href="/Dashboard/Result" class="btn btn-gold" style="margin-top:16px;">Go to My Results</a>`;
            box.style.display = 'block';
        })
        .catch(() => {
            alert('Network error — please try again.');
            btn.disabled = false; btn.textContent = 'Submit Exam';
        });
    }
</script>
