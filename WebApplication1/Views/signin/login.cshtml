<!-- PORTAL SECTION -->
<div id="portalBox" style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:100px 16px 60px;">
    <div style="width:100%;max-width:480px;">

        <!-- LOGO -->
        <div style="text-align:center;margin-bottom:36px;">
            <img src="../assets/images/logo.svg" alt="Symphony Limited" style="height:52px;margin-bottom:16px;" />
            <h2 style="margin-bottom:6px;">Student Portal</h2>
            <p style="font-size:.875rem;">Login or register to access your dashboard, results, and enrollment status.</p>
        </div>

        <!-- TAB SWITCHER -->
        <div style="display:flex;background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:4px;margin-bottom:28px;">
            <button class="tab-btn active" data-tab="login" onclick="switchPortalTab('login')" style="flex:1;padding:10px;border:none;border-radius:calc(var(--radius-md) - 2px);background:var(--gold);color:#000;font-weight:600;cursor:pointer;transition:all .2s;">
                <i class="bi bi-person-fill"></i> Login
            </button>
            <button class="tab-btn" data-tab="register" onclick="switchPortalTab('register')" style="flex:1;padding:10px;border:none;border-radius:calc(var(--radius-md) - 2px);background:transparent;color:var(--text-muted);font-weight:600;cursor:pointer;transition:all .2s;">
                <i class="bi bi-person-plus"></i> Register
            </button>
        </div>

        <!-- LOGIN PANEL -->
        <div class="tab-panel active" data-tab="login">
            <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-xl);padding:36px;position:relative;overflow:hidden;">
                <div style="position:absolute;top:0;left:15%;right:15%;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);"></div>
                <h4 style="margin-bottom:4px;">Welcome Back</h4>
                <p style="font-size:.82rem;margin-bottom:24px;">Enter your credentials to access your portal.</p>
                @if (TempData["LoginError"] != null)
                {
                    <div style="background:rgba(224,92,92,.1);border:1px solid rgba(224,92,92,.3);border-radius:var(--radius-sm);padding:11px 14px;font-size:.8rem;color:var(--danger);margin-bottom:18px;">
                        <i class="bi bi-exclamation-circle"></i> @TempData["LoginError"]
                    </div>
                }
                <form asp-controller="signin" asp-action="Login" method="post" novalidate>
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <div class="form-control-icon">
                            <i class="bi bi-envelope"></i>
                            <input type="email" name="email" id="loginEmail" class="form-control" placeholder="your@email.com" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label" style="display:flex;justify-content:space-between;">
                            <span>Password</span>
                            <a href="#" style="font-size:.78rem;color:var(--gold);">Forgot Password?</a>
                        </label>
                        <div class="form-control-icon" style="position:relative;">
                            <i class="bi bi-lock"></i>
                            <input type="password" name="password" id="loginPass" class="form-control" placeholder="Your password" required />
                            <button type="button" onclick="togglePwd('loginPass',this)" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer;padding:0;">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <button type="submit" id="loginBtn" class="btn btn-gold btn-full btn-lg"><i class="bi bi-person-fill"></i> Login to Portal</button>
                </form>
                <p style="text-align:center;font-size:.82rem;margin-top:18px;">
                    Don't have an account? <a href="#" onclick="switchPortalTab('register')" style="color:var(--gold);">Register here</a>
                </p>
            </div>
        </div>

        <!-- REGISTER PANEL -->
        <div class="tab-panel" data-tab="register" style="display:none;">
            <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-xl);padding:36px;position:relative;overflow:hidden;">
                <div style="position:absolute;top:0;left:15%;right:15%;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);"></div>
                <h4 style="margin-bottom:4px;">Create Account</h4>
                <p style="font-size:.82rem;margin-bottom:24px;">Register as a new student of Symphony Limited.</p>
                @if (TempData["RegisterError"] != null)
                {
                    <div style="background:rgba(224,92,92,.1);border:1px solid rgba(224,92,92,.3);border-radius:var(--radius-sm);padding:11px 14px;font-size:.8rem;color:var(--danger);margin-bottom:18px;">
                        <i class="bi bi-exclamation-circle"></i> @TempData["RegisterError"]
                    </div>
                }
                <form asp-controller="signin" asp-action="Register" method="post" novalidate>
                    <div class="form-group">
                        <label class="form-label">Full Name</label>
                        <div class="form-control-icon">
                            <i class="bi bi-person"></i>
                            <input type="text" name="fullName" id="regName" class="form-control" placeholder="Your full name" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email Address</label>
                        <div class="form-control-icon">
                            <i class="bi bi-envelope"></i>
                            <input type="email" name="email" id="regEmail" class="form-control" placeholder="your@email.com" required />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Phone Number</label>
                        <div class="form-control-icon">
                            <i class="bi bi-telephone"></i>
                            <input type="tel" name="phone" id="regPhone" class="form-control" placeholder="03XX-XXXXXXX" />
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Password</label>
                        <div class="form-control-icon" style="position:relative;">
                            <i class="bi bi-lock"></i>
                            <input type="password" name="password" id="regPass" class="form-control" placeholder="Create a strong password" required />
                            <button type="button" onclick="togglePwd('regPass',this)" style="position:absolute;right:14px;top:50%;transform:translateY(-50%);background:none;border:none;color:var(--text-muted);cursor:pointer;padding:0;">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Preferred Branch</label>
                        <select name="branchId" id="regBranch" class="form-control">
                            <option value="">Select your nearest branch</option>
                            @if (ViewBag.Branches != null)
                            {
                                @foreach (var b in (List<WebApplication1.Models.Branch>)ViewBag.Branches)
                                {
                                    <option value="@b.BranchId">@b.BranchName</option>
                                }
                            }
                        </select>
                    </div>
                    <div style="background:var(--gold-dim);border:1px solid var(--border);border-radius:var(--radius-sm);padding:11px 14px;font-size:.78rem;color:var(--text-secondary);margin-bottom:20px;">
                        <i class="bi bi-info-circle" style="color:var(--gold);margin-right:5px;"></i>
                        After registering, visit your branch to complete enrollment and appear in the entrance exam.
                    </div>
                    <button type="submit" id="registerBtn" class="btn btn-gold btn-full btn-lg"><i class="bi bi-person-plus"></i> Create Account</button>
                </form>
                <p style="text-align:center;font-size:.82rem;margin-top:18px;">
                    Already have an account? <a href="#" onclick="switchPortalTab('login')" style="color:var(--gold);">Login here</a>
                </p>
            </div>
        </div>

        <!-- BACK TO HOME -->
        <div style="text-align:center;margin-top:24px;">
            <a asp-action="index" asp-controller="Home" style="font-size:.82rem;color:var(--text-muted);display:inline-flex;align-items:center;gap:6px;">
                <i class="bi bi-arrow-left"></i> Back to Homepage
            </a>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="../js/script.js"></script>
<script>
    // Tab visual switch
    const origSwitch = switchPortalTab;
    function switchPortalTab(tab) {
    document.querySelectorAll('.tab-btn').forEach(b => {
    const isActive = b.dataset.tab === tab;
    b.style.background = isActive ? 'var(--gold)' : 'transparent';
    b.style.color = isActive ? '#000' : 'var(--text-muted)';
    b.classList.toggle('active', isActive);
    });
    document.querySelectorAll('.tab-panel').forEach(p => {
    p.style.display = p.dataset.tab === tab ? 'block' : 'none';
    p.classList.toggle('active', p.dataset.tab === tab);
    });
    }
</script>
