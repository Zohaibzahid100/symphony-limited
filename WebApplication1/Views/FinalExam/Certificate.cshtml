@using WebApplication1.Models
@{
    ViewData["Title"] = "Certificate";
    Layout = null;
    var result = (FinalResult)Model;
    var studentName = result.Student?.User?.FullName ?? "Student";
    var courseName = result.FinalExam?.Course?.CourseName ?? "Course";
    var examTitle = result.FinalExam?.ExamTitle ?? "Final Exam";
    var rollNumber = result.Student?.RollNumber ?? "—";
    var dateStr = (result.ResultDate ?? DateOnly.FromDateTime(DateTime.Now)).ToString("dd MMMM yyyy");
    var certId = $"SL-{result.ResultId:D6}";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Certificate — @studentName</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <style>
        @@page { size: A4 landscape; margin: 0; }
        * { box-sizing: border-box; }
        body {
            margin: 0; font-family: 'Georgia', serif; background: #0f0f10;
            display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 24px;
        }
        .cert {
            width: 1000px; max-width: 100%; aspect-ratio: 1.41/1; background: #14110c;
            border: 10px solid #c9a23f; outline: 2px solid #c9a23f; outline-offset: -22px;
            position: relative; padding: 50px 60px; color: #f1e9d8;
            display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
        }
        .cert::before, .cert::after {
            content: ''; position: absolute; width: 70px; height: 70px; border: 3px solid #c9a23f;
        }
        .cert::before { top: 14px; left: 14px; border-right: none; border-bottom: none; }
        .cert::after { bottom: 14px; right: 14px; border-left: none; border-top: none; }
        .brand { letter-spacing: .3em; font-size: .8rem; color: #c9a23f; text-transform: uppercase; margin-bottom: 6px; }
        .title { font-size: 2.6rem; color: #c9a23f; margin: 6px 0 4px; letter-spacing: .05em; }
        .subtitle { font-size: .95rem; color: #b9ab8e; margin-bottom: 26px; }
        .awarded { font-size: 1rem; color: #b9ab8e; }
        .name { font-size: 2.2rem; color: #fff; margin: 10px 0 16px; font-family: 'Georgia', serif; border-bottom: 1px solid #c9a23f; display: inline-block; padding-bottom: 8px; }
        .desc { max-width: 640px; font-size: 1rem; line-height: 1.7; color: #d8cdb6; margin-bottom: 22px; }
        .desc strong { color: #c9a23f; }
        .meta-row { display: flex; gap: 60px; margin-top: 18px; }
        .meta-item { text-align: center; }
        .meta-item .label { font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; color: #8a7e68; margin-bottom: 4px; }
        .meta-item .value { font-size: .95rem; color: #f1e9d8; border-top: 1px solid #4a4330; padding-top: 6px; min-width: 140px; }
        .cert-id { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); font-size: .7rem; color: #6b6044; letter-spacing: .05em; }
        .print-bar { margin-top: 20px; display: flex; gap: 12px; }
        .print-bar button { background: #c9a23f; color: #14110c; border: none; padding: 10px 22px; border-radius: 6px; font-weight: 600; cursor: pointer; font-family: sans-serif; }
        .print-bar button.outline { background: transparent; border: 1px solid #c9a23f; color: #c9a23f; }
        @@media print {
            body { background: #fff; padding: 0; }
            .print-bar { display: none; }
            .cert { border-color: #c9a23f; }
        }
    </style>
</head>
<body>
    <div>
        <div class="cert">
            <div class="brand"><i class="bi bi-award"></i> Symphony Limited</div>
            <div class="title">Certificate of Completion</div>
            <div class="subtitle">This certificate is proudly presented to</div>
            <div class="name">@studentName</div>
            <div class="desc">
                for successfully completing the <strong>@courseName</strong> programme and passing the
                <strong>@examTitle</strong> with a score of <strong>@result.Percentage%</strong>, Grade <strong>@(result.Grade ?? "—")</strong>.
            </div>
            <div class="meta-row">
                <div class="meta-item"><div class="label">Roll Number</div><div class="value">@rollNumber</div></div>
                <div class="meta-item"><div class="label">Date Issued</div><div class="value">@dateStr</div></div>
                <div class="meta-item"><div class="label">Result</div><div class="value">@result.ResultStatus</div></div>
            </div>
            <div class="cert-id">Certificate ID: @certId &bull; Verify at Symphony Limited Student Portal</div>
        </div>
        <div class="print-bar">
            <button onclick="window.print()"><i class="bi bi-download"></i> Download / Print PDF</button>
            <button class="outline" onclick="window.close()">Close</button>
        </div>
    </div>
</body>
</html>
