@{
    ViewData["Title"] = "About Us";
}
<div class="page-hero">
    <div class="container text-center">
        <div class="breadcrumb"><a href="../index.html">Home</a><i class="bi bi-chevron-right"></i><span>About Us</span></div>
        <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-building-fill"></i> Our Story</div>
        <h1>About <span style="color:var(--gold);">Symphony Limited</span></h1>
        <p style="max-width:560px;margin:12px auto 0;color:var(--text-secondary);">A decade of empowering students with industry-ready IT skills in Karachi, Pakistan.</p>
    </div>
</div>

<!-- ABOUT MAIN -->
<section class="section">
    <div class="container">
        <div class="about-grid">
            <div class="about-visual">
                <div class="about-img-main">
                    <img src="../assets/images/about-institute.svg" alt="Symphony Limited" style="width:100%;height:100%;object-fit:cover;border-radius:var(--radius-lg);" />
                </div>
                <div class="about-img-accent">
                    <div class="about-years"><span data-counter="10" data-suffix="+">0</span></div>
                    <div style="font-size:.72rem;color:var(--text-muted);text-align:center;margin-top:4px;">Years of<br>Excellence</div>
                </div>
            </div>
            <div>
                <div class="section-tag"><i class="bi bi-info-circle"></i> Who We Are</div>
                <h2 class="section-title">Empowering Students with <span>Industry-Ready</span> Skills</h2>
                <div class="divider"></div>
                @{ var aboutSections = (List<AboutU>)ViewBag.AboutSections; }
                @if (aboutSections != null && aboutSections.Any())
                {
                    @foreach (var sections in aboutSections)
                    {
                        if (!string.IsNullOrWhiteSpace(sections.SectionTitle))
                        {
                            <h4 style="margin-bottom:8px;">@sections.SectionTitle</h4>
                        }
                        <p style="margin-bottom:18px;">@sections.Description</p>
                    }
                }
                else
                {
                    <p style="margin-bottom:18px;">Symphony Limited is a premier IT education institute based in Karachi, Pakistan. We offer structured, industry-aligned courses designed to prepare students for the modern digital economy.</p>
                    <p style="margin-bottom:28px;">Our unique entrance exam system ensures every student is placed in the correct track — Basic or Advanced — maximizing their learning outcomes and career readiness. With @ViewBag.BranchCount branches across Karachi, we are accessible to students across the city.</p>
                }
                <ul class="about-list">
                    <li><i class="bi bi-check-circle-fill"></i><span>Structured entrance-based admission with automated track assignment</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Professional faculty with real-world industry experience</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Multiple branches across Karachi for maximum accessibility</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Lab facilities available during and after course completion</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Certification exams with graded results and faculty remarks</span></li>
                    <li><i class="bi bi-check-circle-fill"></i><span>Flexible payment methods: Cash, Cheque, and Bank Draft</span></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<!-- STATS -->
<section style="padding:56px 0;background:var(--bg-card);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light);">
    <div class="container">
        <div class="grid-4" style="text-align:center;">
            <div>
                <div style="font-family:var(--font-display);font-size:2.8rem;color:var(--gold);font-weight:700;line-height:1;"><span data-counter="@ViewBag.StudentCount" data-suffix="+">0</span></div>
                <div style="font-size:.82rem;color:var(--text-muted);margin-top:6px;text-transform:uppercase;letter-spacing:.08em;">Students Enrolled</div>
            </div>
            <div>
                <div style="font-family:var(--font-display);font-size:2.8rem;color:var(--gold);font-weight:700;line-height:1;"><span data-counter="@ViewBag.BranchCount" data-suffix="">0</span></div>
                <div style="font-size:.82rem;color:var(--text-muted);margin-top:6px;text-transform:uppercase;letter-spacing:.08em;">Active Branches</div>
            </div>
            <div>
                <div style="font-family:var(--font-display);font-size:2.8rem;color:var(--gold);font-weight:700;line-height:1;"><span data-counter="@ViewBag.CourseCount" data-suffix="+">0</span></div>
                <div style="font-size:.82rem;color:var(--text-muted);margin-top:6px;text-transform:uppercase;letter-spacing:.08em;">Courses Offered</div>
            </div>
            <div>
                <div style="font-family:var(--font-display);font-size:2.8rem;color:var(--gold);font-weight:700;line-height:1;"><span data-counter="@ViewBag.PassRate" data-suffix="%">0</span></div>
                <div style="font-size:.82rem;color:var(--text-muted);margin-top:6px;text-transform:uppercase;letter-spacing:.08em;">Pass Rate</div>
            </div>
        </div>
    </div>
</section>

<!-- MISSION / VISION -->
<section class="section">
    <div class="container">
        <div class="text-center" style="margin-bottom:48px;">
            <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-bullseye"></i> Our Purpose</div>
            <h2 class="section-title">Mission &amp; <span>Vision</span></h2>
        </div>
        <div class="grid-2">
            <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-lg);padding:36px;border-top:3px solid var(--gold);">
                <div style="width:52px;height:52px;border-radius:var(--radius-md);background:var(--gold-dim);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:1.4rem;margin-bottom:20px;"><i class="bi bi-flag-fill"></i></div>
                <h3 style="margin-bottom:12px;">Our Mission</h3>
                <p>To empower students with practical, industry-ready skills through structured education programs that bridge the gap between academic knowledge and professional requirements in Pakistan's IT sector.</p>
            </div>
            <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-lg);padding:36px;border-top:3px solid var(--info);">
                <div style="width:52px;height:52px;border-radius:var(--radius-md);background:rgba(78,170,255,.1);border:1px solid rgba(78,170,255,.2);display:flex;align-items:center;justify-content:center;color:var(--info);font-size:1.4rem;margin-bottom:20px;"><i class="bi bi-eye-fill"></i></div>
                <h3 style="margin-bottom:12px;">Our Vision</h3>
                <p>To become the most trusted IT education institute in Pakistan, recognized for producing skilled professionals who contribute meaningfully to the digital economy and uplifting communities through education.</p>
            </div>
        </div>
    </div>
</section>

<!-- VALUES -->
<section class="section-sm" style="background:var(--bg-card);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light);">
    <div class="container">
        <div class="text-center" style="margin-bottom:40px;">
            <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-heart"></i> Core Values</div>
            <h2 class="section-title">What We <span>Stand For</span></h2>
        </div>
        <div class="grid-4">
            <div style="text-align:center;padding:24px 16px;"><div style="font-size:2.4rem;margin-bottom:14px;">🎯</div><h5 style="margin-bottom:8px;">Excellence</h5><p style="font-size:.83rem;">We pursue the highest standards in education, delivery, and student outcomes.</p></div>
            <div style="text-align:center;padding:24px 16px;"><div style="font-size:2.4rem;margin-bottom:14px;">🤝</div><h5 style="margin-bottom:8px;">Integrity</h5><p style="font-size:.83rem;">Transparent admissions, fair results, and honest guidance for every student.</p></div>
            <div style="text-align:center;padding:24px 16px;"><div style="font-size:2.4rem;margin-bottom:14px;">💡</div><h5 style="margin-bottom:8px;">Innovation</h5><p style="font-size:.83rem;">Continuously updating our curriculum to match industry demands and trends.</p></div>
            <div style="text-align:center;padding:24px 16px;"><div style="font-size:2.4rem;margin-bottom:14px;">🌱</div><h5 style="margin-bottom:8px;">Growth</h5><p style="font-size:.83rem;">Supporting every student's personal and professional development journey.</p></div>
        </div>
    </div>
</section>

<!-- FAQ -->
<section class="section">
    <div class="container">
        <div class="text-center" style="margin-bottom:40px;">
            <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-question-circle"></i> FAQs</div>
            <h2 class="section-title">Frequently Asked <span>Questions</span></h2>
        </div>
        <div style="max-width:760px;margin:0 auto;">
            @foreach (var faq in (List<Faq>)ViewBag.Faqs)
            {
                <div class="faq-item"><div class="faq-question"><span>@faq.Question</span><i class="bi bi-chevron-down"></i></div><div class="faq-answer"><div class="faq-answer-inner">@faq.Answer</div></div></div>
            }
        <div class="text-center" style="margin-top:32px;">
            <a href="contact.html" class="btn btn-outline"><i class="bi bi-envelope"></i> Have More Questions? Contact Us</a>
        </div>
    </div>
</section>
