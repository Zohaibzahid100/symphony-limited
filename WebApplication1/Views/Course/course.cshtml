@{
    ViewData["Title"] = "Courses";
}

<!-- PAGE HERO -->
<div class="page-hero">
    <div class="container text-center">
        <div class="breadcrumb"><a href="../index.html">Home</a><i class="bi bi-chevron-right"></i><span>Courses</span></div>
        <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-collection-fill"></i> All Programs</div>
        <h1>Our <span style="color:var(--gold);">Courses</span></h1>
        <p style="max-width:520px;margin:12px auto 0;color:var(--text-secondary);">Professionally designed courses with Basic and Advanced tracks, based on your entrance exam performance.</p>
    </div>
</div>

<!-- FILTER BAR -->
<section style="padding:32px 0;background:var(--bg-card);border-bottom:1px solid var(--border-light);">
    <div class="container" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div style="display:flex;align-items:center;gap:8px;">
            <span style="font-size:.82rem;color:var(--text-muted);">Filter:</span>
            <button class="btn btn-gold btn-sm filter-btn" data-filter="all" onclick="filterCourses('all')">All Courses</button>
            <button class="btn btn-ghost btn-sm filter-btn" data-filter="basic" onclick="filterCourses('basic')">Basic Track</button>
            <button class="btn btn-ghost btn-sm filter-btn" data-filter="advanced" onclick="filterCourses('advanced')">Advanced Track</button>
        </div>
        <span style="font-size:.82rem;color:var(--text-muted);">@ViewBag.CourseCount Courses Available</span>
    </div>
</section>

<!-- COURSES GRID -->
<section class="section">
    <div class="container">
        <div class="grid-3" id="coursesGrid">

            @{ string[] icons = { "🌐", "🗄️", "🎨", "🔌" }; string[] imgs = { "course-web-dev.svg", "course-database.svg", "course-graphic-design.svg", "course-networking.svg" }; }
            @foreach (var course in (List<Course>)ViewBag.Courses)
            {
                var basicTrack = course.CourseTracks.OrderBy(t => t.CourseFee).FirstOrDefault();
                var advTrack = course.CourseTracks.OrderByDescending(t => t.CourseFee).FirstOrDefault();
                <div class="card" data-course-id="@course.CourseId">
                    <div class="card-img-placeholder" style="border-radius:var(--radius-lg) var(--radius-lg) 0 0;height:150px;">
                        <img src="~/assets/images/@(imgs[course.CourseId % imgs.Length])" alt="@course.CourseName" style="width:100%;height:150px;object-fit:cover;border-radius:var(--radius-lg) var(--radius-lg) 0 0;" onerror="this.style.display='none';this.parentElement.innerHTML='<span style=font-size:3.5rem>@icons[course.CourseId % icons.Length]</span>'" />
                    </div>
                    <div class="card-body">
                        <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;">
                            <h3 style="font-size:1.15rem;">@course.CourseName</h3>
                            <span class="badge @(course.CourseStatus == "Available" ? "badge-green" : "badge-blue")">@course.CourseStatus</span>
                        </div>
                        <p style="font-size:.875rem;margin-bottom:18px;">@course.Description</p>
                        <div style="border-top:1px solid var(--border-light);padding-top:18px;">
                            @foreach (var track in course.CourseTracks)
                            {
                                bool isBasic = basicTrack != null && track.TrackId == basicTrack.TrackId;
                                <div class="track-row" data-track="@(isBasic ? "basic" : "advanced")" style="display:flex;justify-content:space-between;align-items:center;padding:11px 0;border-bottom:1px solid var(--border-light);">
                                    <div>
                                        <div style="font-weight:600;font-size:.88rem;margin-bottom:3px;">@track.TrackName Track</div>
                                        <div style="font-size:.76rem;color:var(--text-muted);">@(track.DurationMonths) Months</div>
                                    </div>
                                    <div style="font-family:var(--font-display);color:var(--gold);">PKR @track.CourseFee.ToString("N0")</div>
                                </div>
                            }
                        </div>
                        <div style="display:flex;gap:10px;margin-top:18px;">
                            <button onclick="showCourseModal(@course.CourseId)" class="btn btn-outline" style="flex:1;">Details</button>
                            <a asp-controller="EntranceExam" asp-action="enExam" class="btn btn-gold" style="flex:1;">Apply <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                </div>
            }


        </div>
    </div>
</section>

<!-- TRACK COMPARE TABLE -->
<section class="section-sm" style="background:var(--bg-card);border-top:1px solid var(--border-light);">
    <div class="container">
        <div class="text-center" style="margin-bottom:40px;">
            <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-table"></i> Comparison</div>
            <h2 class="section-title">Track <span>Comparison</span></h2>
        </div>
        <div class="table-wrapper" style="max-width:800px;margin:0 auto;">
            <table>
                <thead>
                    <tr>
                        <th>Feature</th>
                        <th style="color:var(--info);">Basic Track (DISM)</th>
                        <th style="color:var(--gold);">Advanced Track (CPISM)</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td><strong>Admission Score</strong></td><td>0 – 49%</td><td>50 – 100%</td></tr>
                    <tr><td><strong>Duration</strong></td><td>2 – 3 Months</td><td>4 – 5 Months</td></tr>
                    <tr><td><strong>Focus</strong></td><td>Fundamentals &amp; Basics</td><td>Frameworks &amp; Industry Tools</td></tr>
                    <tr><td><strong>Certificate</strong></td><td><i class="bi bi-check2" style="color:var(--success);"></i> Yes</td><td><i class="bi bi-check2" style="color:var(--success);"></i> Yes</td></tr>
                    <tr><td><strong>Lab Access</strong></td><td><i class="bi bi-check2" style="color:var(--success);"></i> During Course</td><td><i class="bi bi-check2" style="color:var(--success);"></i> During + After</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- COURSE DETAIL MODAL (was missing on this page) -->
<div class="modal-overlay" id="courseModal">
    <div class="modal-box">
        <div class="modal-header">
            <h4 id="modalCourseTitle">Course Details</h4>
            <button class="modal-close" onclick="closeModal('courseModal')"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="modal-body" id="modalCourseBody"></div>
    </div>
</div>
