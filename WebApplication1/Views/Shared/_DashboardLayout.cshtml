<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — Symphony Limited</title>
    <link rel="icon" href="~/assets/images/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
            @@import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,900;1,400&family=DM+Sans:wght@300;400;500;600;700&display=swap');

            :root {
                --bg-dark: #0a0c10;
                --bg-card: #10141c;
                --bg-card2: #151a25;
                --border: rgba(212,175,55,0.18);
                --border-light: rgba(255,255,255,0.07);
                --gold: #d4af37;
                --gold-light: #f0d060;
                --gold-dim: rgba(212,175,55,0.12);
                --gold-glow: rgba(212,175,55,0.35);
                --text-primary: #f0ece2;
                --text-secondary: #9fa8b8;
                --text-muted: #5c6478;
                --success: #2ecc8f;
                --danger: #e05c5c;
                --info: #4eaaff;
                --radius-sm: 6px;
                --radius-md: 12px;
                --radius-lg: 20px;
                --radius-xl: 32px;
                --shadow-card: 0 4px 32px rgba(0,0,0,0.45);
                --shadow-gold: 0 0 24px rgba(212,175,55,0.25);
                --transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
                --font-display: 'Playfair Display', Georgia, serif;
                --font-body: 'DM Sans', sans-serif;
            }

            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            html {
                font-size: 16px;
            }

            body.dashboard-body {
                background: var(--bg-dark);
                color: var(--text-primary);
                font-family: var(--font-body);
                font-weight: 400;
                line-height: 1.65;
                overflow-x: hidden;
                -webkit-font-smoothing: antialiased;
            }

            a {
                color: inherit;
                text-decoration: none;
            }

            ul, ol {
                list-style: none;
            }

            img {
                max-width: 100%;
                display: block;
            }

            ::-webkit-scrollbar {
                width: 6px;
            }

            ::-webkit-scrollbar-track {
                background: var(--bg-dark);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--gold);
                border-radius: 3px;
            }

            ::selection {
                background: var(--gold);
                color: var(--bg-dark);
            }

            h1, h2, h3, h4, h5 {
                font-family: var(--font-display);
                font-weight: 700;
                line-height: 1.2;
                color: var(--text-primary);
            }

            h2 {
                font-size: clamp(1.8rem, 3.5vw, 2.8rem);
            }

            h4 {
                font-size: 1.2rem;
            }

            p {
                color: var(--text-secondary);
                line-height: 1.75;
            }

            /* BUTTONS */
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 12px 28px;
                border-radius: var(--radius-sm);
                font-size: 0.875rem;
                font-weight: 600;
                cursor: pointer;
                border: none;
                transition: var(--transition);
                white-space: nowrap;
                font-family: var(--font-body);
            }

            .btn-gold {
                background: linear-gradient(135deg, var(--gold), #b8962e);
                color: var(--bg-dark);
            }

                .btn-gold:hover {
                    background: linear-gradient(135deg, var(--gold-light), var(--gold));
                    box-shadow: var(--shadow-gold);
                    transform: translateY(-2px);
                }

            .btn-outline {
                background: transparent;
                border: 1px solid var(--border);
                color: var(--text-primary);
            }

                .btn-outline:hover {
                    border-color: var(--gold);
                    color: var(--gold);
                    background: var(--gold-dim);
                }

            .btn-ghost {
                background: var(--bg-card2);
                color: var(--text-primary);
                border: 1px solid var(--border-light);
            }

                .btn-ghost:hover {
                    border-color: var(--gold);
                    color: var(--gold);
                }

            .btn-sm {
                padding: 8px 18px;
                font-size: 0.8rem;
            }

            /* BADGE */
            .badge {
                display: inline-flex;
                align-items: center;
                padding: 4px 12px;
                border-radius: 100px;
                font-size: 0.72rem;
                font-weight: 600;
                letter-spacing: 0.04em;
            }

            .badge-gold {
                background: var(--gold-dim);
                color: var(--gold);
                border: 1px solid var(--border);
            }

            .badge-green {
                background: rgba(46,204,143,0.1);
                color: var(--success);
            }

            .badge-red {
                background: rgba(224,92,92,0.1);
                color: var(--danger);
            }

            .badge-blue {
                background: rgba(78,170,255,0.1);
                color: var(--info);
            }

            /* CARD */
            .card {
                background: var(--bg-card);
                border: 1px solid var(--border-light);
                border-radius: var(--radius-lg);
                overflow: hidden;
                transition: var(--transition);
            }

                .card:hover {
                    border-color: var(--border);
                    box-shadow: var(--shadow-card);
                    transform: translateY(-4px);
                }

            .card-body {
                padding: 28px;
            }

            /* GRID */
            .grid-2 {
                display: grid;
                grid-template-columns: repeat(2,1fr);
                gap: 28px;
            }

            .grid-4 {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 24px;
            }

            /* ── TOPBAR ── */
            #sb-toggle {
                display: none;
            }

            .dash-topbar {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                height: 64px;
                background: var(--bg-card);
                border-bottom: 1px solid var(--border-light);
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0 24px;
                z-index: 500;
            }

            /* ── LAYOUT ── */
            .dash-layout {
                display: flex;
                min-height: 100vh;
                padding-top: 64px;
            }

            /* ── SIDEBAR ── */
            .sidebar {
                width: 260px;
                min-width: 260px;
                background: var(--bg-card);
                border-right: 1px solid var(--border-light);
                display: flex;
                flex-direction: column;
                position: sticky;
                top: 64px;
                height: calc(100vh - 64px);
                overflow-y: auto;
                padding: 24px 0 32px;
                flex-shrink: 0;
            }

            .sidebar-user {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0 20px 20px;
                border-bottom: 1px solid var(--border-light);
                margin-bottom: 16px;
            }

            .sidebar-avatar {
                width: 44px;
                height: 44px;
                border-radius: 50%;
                background: linear-gradient(135deg, var(--gold), #8b6914);
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: var(--font-display);
                font-size: 1.2rem;
                font-weight: 700;
                color: var(--bg-dark);
                flex-shrink: 0;
            }

            .sidebar-user-info {
                overflow: hidden;
            }

            .sidebar-name {
                font-weight: 600;
                font-size: .9rem;
                color: var(--text-primary);
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
            }

            .sidebar-roll {
                font-size: .75rem;
                color: var(--gold);
                margin-top: 2px;
            }

            .sidebar-nav {
                display: flex;
                flex-direction: column;
                padding: 0 12px;
            }

            .sidebar-section-label {
                font-size: .68rem;
                text-transform: uppercase;
                letter-spacing: .1em;
                color: var(--text-muted);
                padding: 16px 8px 6px;
                font-weight: 600;
            }

            .sidebar-link {
                display: flex;
                align-items: center;
                gap: 10px;
                padding: 10px 12px;
                border-radius: var(--radius-sm);
                color: var(--text-secondary);
                text-decoration: none;
                font-size: .875rem;
                font-weight: 500;
                transition: var(--transition);
                margin-bottom: 2px;
                border: none;
                background: none;
                width: 100%;
                text-align: left;
                cursor: pointer;
            }

                .sidebar-link i {
                    width: 18px;
                    text-align: center;
                    color: var(--text-muted);
                    flex-shrink: 0;
                }

                .sidebar-link:hover {
                    background: var(--bg-card2);
                    color: var(--text-primary);
                }

                    .sidebar-link:hover i {
                        color: var(--gold);
                    }

                .sidebar-link.active {
                    background: var(--gold-dim);
                    color: var(--gold);
                    border: 1px solid var(--border);
                }

                    .sidebar-link.active i {
                        color: var(--gold);
                    }

            .sidebar-link-logout {
                color: var(--danger) !important;
                margin-top: 12px;
            }

                .sidebar-link-logout:hover {
                    background: rgba(224,92,92,.08) !important;
                }

            /* ── MAIN CONTENT ── */
            .dash-content {
                flex: 1;
                min-width: 0;
                padding: 32px 36px;
                overflow-y: auto;
            }

            /* ── WELCOME BANNER ── */
            .dash-welcome {
                background: var(--bg-card);
                border: 1px solid var(--border-light);
                border-radius: var(--radius-xl);
                padding: 32px 36px;
                margin-bottom: 28px;
                position: relative;
                overflow: hidden;
            }

                .dash-welcome::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: radial-gradient(ellipse at top left, rgba(212,175,55,.08) 0%, transparent 60%);
                    pointer-events: none;
                }

            /* ── STAT GRID ── */
            .stat-grid {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 20px;
                margin-bottom: 28px;
            }

            .stat-card {
                background: var(--bg-card);
                border: 1px solid var(--border-light);
                border-radius: var(--radius-lg);
                padding: 24px 20px;
                display: flex;
                flex-direction: column;
                gap: 10px;
                transition: var(--transition);
            }

                .stat-card:hover {
                    border-color: var(--border);
                }

            .stat-icon {
                width: 44px;
                height: 44px;
                border-radius: var(--radius-sm);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.2rem;
            }

                .stat-icon.gold {
                    background: var(--gold-dim);
                    color: var(--gold);
                    border: 1px solid var(--border);
                }

                .stat-icon.green {
                    background: rgba(46,204,143,.1);
                    color: var(--success);
                    border: 1px solid rgba(46,204,143,.2);
                }

                .stat-icon.blue {
                    background: rgba(78,170,255,.1);
                    color: var(--info);
                    border: 1px solid rgba(78,170,255,.2);
                }

                .stat-icon.red {
                    background: rgba(224,92,92,.1);
                    color: var(--danger);
                    border: 1px solid rgba(224,92,92,.2);
                }

            .stat-num {
                font-family: var(--font-display);
                font-size: 2rem;
                font-weight: 700;
                color: var(--text-primary);
                line-height: 1;
            }

            .stat-label {
                font-size: .78rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: .06em;
            }

            /* ── TABLE WRAPPER ── */
            .table-wrapper {
                background: var(--bg-card);
                border: 1px solid var(--border-light);
                border-radius: var(--radius-lg);
                overflow: hidden;
            }

            .table-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 16px 20px;
                border-bottom: 1px solid var(--border-light);
            }

                .table-header h4 {
                    margin: 0;
                    font-size: .95rem;
                }

            .table-wrapper table {
                width: 100%;
                border-collapse: collapse;
            }

            .table-wrapper th {
                padding: 10px 20px;
                font-size: .72rem;
                text-transform: uppercase;
                letter-spacing: .08em;
                color: var(--text-muted);
                font-weight: 600;
                background: var(--bg-card2);
                border-bottom: 1px solid var(--border-light);
                text-align: left;
            }

            .table-wrapper td {
                padding: 13px 20px;
                font-size: .875rem;
                color: var(--text-secondary);
                border-bottom: 1px solid var(--border-light);
                vertical-align: middle;
            }

            .table-wrapper tr:last-child td {
                border-bottom: none;
            }

            .table-wrapper tr:hover td {
                background: var(--bg-card2);
            }

            /* ── PROGRESS / SCORE ── */
            .progress-bar {
                height: 6px;
                background: var(--border-light);
                border-radius: 99px;
                overflow: hidden;
            }

            .progress-fill {
                height: 100%;
                background: linear-gradient(90deg, var(--gold), #f0c040);
                border-radius: 99px;
                transition: width .6s ease;
            }

            .score-percent {
                font-family: var(--font-display);
                font-size: 1.4rem;
                font-weight: 700;
                color: var(--gold);
                line-height: 1;
            }

            /* ── OVERLAY ── */
            .sb-overlay {
                display: none;
            }

            /* ── RESPONSIVE ── */
            @@media (max-width: 1024px) {
                .sidebar {
                    display: none;
                    position: fixed;
                    top: 64px;
                    left: 0;
                    bottom: 0;
                    height: calc(100vh - 64px);
                    z-index: 600;
                    width: 260px;
                }

                #sb-toggle:checked ~ .dash-layout .sidebar {
                    display: flex;
                }

                .sb-overlay {
                    display: none;
                    position: fixed;
                    inset: 0;
                    background: rgba(0,0,0,.5);
                    z-index: 599;
                    cursor: pointer;
                }

                #sb-toggle:checked ~ .dash-layout .sb-overlay {
                    display: block;
                }

                .dash-content {
                    padding: 24px 20px;
                }

                .stat-grid {
                    grid-template-columns: repeat(2, 1fr);
                }

                .grid-2 {
                    grid-template-columns: 1fr;
                }

                #sbBtn {
                    display: flex !important;
                }
            }

            @@media (max-width: 600px) {
                .dash-content {
                    padding: 18px 14px;
                }

                .stat-grid {
                    grid-template-columns: repeat(2, 1fr);
                    gap: 12px;
                }

                .stat-card {
                    padding: 18px 14px;
                }

                .dash-welcome {
                    padding: 22px 20px;
                }

                .grid-4 {
                    grid-template-columns: repeat(2, 1fr);
                }
            }
    </style>
</head>
<body class="dashboard-body">

    <input type="checkbox" id="sb-toggle" />

    @await Html.PartialAsync("_Topbar")

    <div class="dash-layout">
        <label class="sb-overlay" for="sb-toggle"></label>

        @await Html.PartialAsync("_Sidebar")

        <main class="dash-content">
            @RenderBody()
        </main>
    </div>

    <script src="~/js/script.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>