@model WebApplication1.Models.Student
@using WebApplication1.Models
@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
    var branches = (List<Branch>)ViewBag.Branches;
}

<div class="dash-welcome">
    <h2>My <span style="color:var(--gold);">Profile</span></h2>
    <p>Update your personal information and preferred branch.</p>
</div>

@if (TempData["LoginSuccess"] != null)
{
    <div style="background:rgba(46,204,143,.1);border:1px solid rgba(46,204,143,.3);border-radius:var(--radius-sm);padding:11px 14px;font-size:.85rem;color:var(--success);margin-bottom:20px;">
        <i class="bi bi-check-circle"></i> @TempData["LoginSuccess"]
    </div>
}

<div class="table-wrapper" style="padding:28px;">
    <form asp-controller="Dashboard" asp-action="UpdateProfile" method="post">
        <div class="grid-2" style="gap:20px;">
            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input type="text" name="fullName" class="form-control" value="@Model.User?.FullName" required />
            </div>
            <div class="form-group">
                <label class="form-label">Email (cannot be changed)</label>
                <input type="email" class="form-control" value="@Model.User?.Email" disabled />
            </div>
            <div class="form-group">
                <label class="form-label">Phone Number</label>
                <input type="tel" name="phone" class="form-control" value="@Model.User?.Phone" />
            </div>
            <div class="form-group">
                <label class="form-label">Roll Number (assigned)</label>
                <input type="text" class="form-control" value="@Model.RollNumber" disabled />
            </div>
            <div class="form-group">
                <label class="form-label">Branch</label>
                <select name="branchId" class="form-control">
                    <option value="">Select branch</option>
                    @foreach (var b in branches)
                    {
                        if (Model.BranchId == b.BranchId)
                        {
                            <option value="@b.BranchId" selected>@b.BranchName</option>
                        }
                        else
                        {
                            <option value="@b.BranchId">@b.BranchName</option>
                        }
                    }
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Registered On</label>
                <input type="text" class="form-control" value="@(Model.RegistrationDate?.ToString("dd MMM yyyy") ?? "—")" disabled />
            </div>
        </div>
        <button type="submit" class="btn btn-gold" style="margin-top:10px;"><i class="bi bi-check2"></i> Save Changes</button>
    </form>
</div>
