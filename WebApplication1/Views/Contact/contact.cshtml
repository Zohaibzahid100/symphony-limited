@{
    ViewData["Title"] = "Contact us";
}
<!-- PAGE HERO -->
<div class="page-hero">
    <div class="container text-center">
        <div class="breadcrumb"><a href="../index.html">Home</a><i class="bi bi-chevron-right"></i><span>Contact Us</span></div>
        <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-envelope-fill"></i> Get In Touch</div>
        <h1>Contact <span style="color:var(--gold);">Us</span></h1>
        <p style="max-width:520px;margin:12px auto 0;color:var(--text-secondary);">Have questions about admissions, courses, fees, or anything else? We are here to help. Reach out and we'll reply within 24 hours.</p>
    </div>
</div>

<!-- CONTACT INFO + FORM -->
<section class="section">
    <div class="container">
        <div class="grid-2" style="gap:56px;align-items:start;">
            <div>
                <div class="section-tag"><i class="bi bi-telephone"></i> Contact Information</div>
                <h2 class="section-title" style="margin-bottom:12px;">We'd Love to <span>Hear From You</span></h2>
                <div class="divider"></div>
                <p style="margin-bottom:36px;">Whether you're a prospective student, parent, or corporate partner — our team is ready to assist you with any query.</p>
                <div style="display:flex;flex-direction:column;gap:18px;">
                    <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:22px;display:flex;align-items:flex-start;gap:16px;">
                        <div style="width:46px;height:46px;border-radius:var(--radius-sm);background:var(--gold-dim);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;color:var(--gold);font-size:1.2rem;flex-shrink:0;"><i class="bi bi-building"></i></div>
                        <div>
                            <strong style="display:block;color:var(--text-primary);margin-bottom:4px;">Head Office</strong>
                            <p style="font-size:.875rem;margin:0;">@(ViewBag.HeadOffice?.Address ?? "Karachi, Pakistan")</p>
                            <a href="https://maps.google.com/?q=@Uri.EscapeDataString(ViewBag.HeadOffice?.Address ?? "Karachi")" target="_blank" style="font-size:.8rem;color:var(--gold);margin-top:4px;display:inline-flex;align-items:center;gap:4px;"><i class="bi bi-map"></i> Open in Maps</a>
                        </div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:22px;display:flex;align-items:flex-start;gap:16px;">
                        <div style="width:46px;height:46px;border-radius:var(--radius-sm);background:rgba(46,204,143,.1);border:1px solid rgba(46,204,143,.2);display:flex;align-items:center;justify-content:center;color:var(--success);font-size:1.2rem;flex-shrink:0;"><i class="bi bi-telephone-fill"></i></div>
                        <div>
                            <strong style="display:block;color:var(--text-primary);margin-bottom:4px;">Phone Numbers</strong>
                            <p style="font-size:.875rem;margin:0;">
                                @foreach (var b in (List<Branch>)ViewBag.Branches)
                                {
                                    <a href="tel:@b.BranchContact" style="color:var(--text-secondary);display:block;margin-top:3px;">@b.BranchContact (@b.BranchName)</a>
                                }
                            </p>
                        </div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:22px;display:flex;align-items:flex-start;gap:16px;">
                        <div style="width:46px;height:46px;border-radius:var(--radius-sm);background:rgba(78,170,255,.1);border:1px solid rgba(78,170,255,.2);display:flex;align-items:center;justify-content:center;color:var(--info);font-size:1.2rem;flex-shrink:0;"><i class="bi bi-envelope-fill"></i></div>
                        <div>
                            <strong style="display:block;color:var(--text-primary);margin-bottom:4px;">Email Addresses</strong>
                            <p style="font-size:.875rem;margin:0;">
                                @foreach (var b in (List<Branch>)ViewBag.Branches)
                                {
                                    <a href="mailto:@b.BranchEmail" style="color:var(--text-secondary);display:block;margin-top:3px;">@b.BranchEmail</a>
                                }
                            </p>
                        </div>
                    </div>
                    <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-md);padding:22px;display:flex;align-items:flex-start;gap:16px;">
                        <div style="width:46px;height:46px;border-radius:var(--radius-sm);background:rgba(224,92,92,.1);border:1px solid rgba(224,92,92,.2);display:flex;align-items:center;justify-content:center;color:var(--danger);font-size:1.2rem;flex-shrink:0;"><i class="bi bi-clock-fill"></i></div>
                        <div>
                            <strong style="display:block;color:var(--text-primary);margin-bottom:4px;">Office Hours</strong>
                            <p style="font-size:.875rem;margin:0;">
                                <span style="display:flex;justify-content:space-between;max-width:240px;"><span>Monday – Saturday</span><strong style="color:var(--success);">9:00 AM – 6:00 PM</strong></span>
                                <span style="display:flex;justify-content:space-between;max-width:240px;margin-top:3px;"><span>Sunday</span><strong style="color:var(--danger);">Closed</strong></span>
                            </p>
                        </div>
                    </div>
                </div>
                <div style="margin-top:28px;">
                    <p style="font-size:.82rem;color:var(--text-muted);margin-bottom:12px;text-transform:uppercase;letter-spacing:.08em;">Follow Us</p>
                    <div class="footer-social">
                        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                        <a href="#" aria-label="LinkedIn"><i class="bi bi-linkedin"></i></a>
                        <a href="#" aria-label="YouTube"><i class="bi bi-youtube"></i></a>
                        <a href="#" aria-label="WhatsApp"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
            </div>

            <!-- CONTACT FORM -->
            <div style="background:var(--bg-card);border:1px solid var(--border-light);border-radius:var(--radius-xl);padding:44px;position:relative;overflow:hidden;">
                <div style="position:absolute;top:0;left:15%;right:15%;height:1px;background:linear-gradient(90deg,transparent,var(--gold),transparent);"></div>
                <div style="margin-bottom:28px;">
                    <h3 style="margin-bottom:6px;">Send Us a Message</h3>
                    <p style="font-size:.875rem;">Fill the form below and our team will get back to you shortly.</p>
                </div>
                <form asp-controller="Contact" asp-action="Send" method="post" novalidate>
                    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;">
                        <div class="form-group">
                            <label class="form-label">Full Name <span style="color:var(--danger);">*</span></label>
                            <div class="form-control-icon"><i class="bi bi-person"></i><input type="text" name="name" id="contactName" class="form-control" placeholder="Your full name" required /></div>
                        </div>
                        <div class="form-group">
                            <label class="form-label">Phone Number</label>
                            <div class="form-control-icon"><i class="bi bi-telephone"></i><input type="tel" name="phone" id="contactPhone" class="form-control" placeholder="03XX-XXXXXXX" /></div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Email Address <span style="color:var(--danger);">*</span></label>
                        <div class="form-control-icon"><i class="bi bi-envelope"></i><input type="email" name="email" id="contactEmail" class="form-control" placeholder="your@email.com" required /></div>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Subject</label>
                        <select name="subject" id="contactSubject" class="form-control">
                            <option value="">Select a topic…</option>
                            <option>Course Inquiry</option>
                            <option>Entrance Exam Query</option>
                            <option>Fee / Payment</option>
                            <option>Branch Information</option>
                            <option>Certificate / Results</option>
                            <option>Lab Session</option>
                            <option>Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Message <span style="color:var(--danger);">*</span></label>
                        <textarea name="message" id="contactMsg" class="form-control" rows="5" placeholder="Write your message here…" style="resize:vertical;" required></textarea>
                    </div>
                    <div class="form-group">
                        <label class="form-label">Preferred Branch (Optional)</label>
                        <select name="branchId" id="contactBranch" class="form-control">
                            <option value="">Any branch</option>
                            @foreach (var b in (List<Branch>)ViewBag.Branches)
                            {
                                <option value="@b.BranchId">@b.BranchName</option>
                            }
                        </select>
                    </div>
                    <button type="submit" id="contactBtn" class="btn btn-gold btn-full btn-lg"><i class="bi bi-send"></i> Send Message</button>
                    <p style="font-size:.78rem;color:var(--text-muted);text-align:center;margin-top:14px;">
                        <i class="bi bi-shield-check" style="color:var(--gold);margin-right:4px;"></i>Your information is kept private and never shared.
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

<!-- BRANCH QUICK CONTACT -->
<section class="section-sm" style="background:var(--bg-card);border-top:1px solid var(--border-light);border-bottom:1px solid var(--border-light);">
    <div class="container">
        <div class="text-center" style="margin-bottom:36px;">
            <div class="section-tag" style="margin:0 auto 16px;"><i class="bi bi-building"></i> Branch Contacts</div>
            <h2 class="section-title">Reach Your <span>Nearest Branch</span></h2>
        </div>
        <div class="grid-3">
            @{ string[] iconColors = { "color:var(--gold);background:var(--gold-dim);border-color:var(--border);", "color:var(--success);background:rgba(46,204,143,.1);border-color:rgba(46,204,143,.2);", "color:var(--info);background:rgba(78,170,255,.1);border-color:rgba(78,170,255,.2);" }; }
            @{ int bi = 0; }
            @foreach (var b in (List<Branch>)ViewBag.Branches)
            {
                <div style="background:var(--bg-card2);border:1px solid var(--border-light);border-radius:var(--radius-lg);padding:28px;text-align:center;">
                    <div style="width:56px;height:56px;border-radius:50%;border:1px solid;display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 16px;@iconColors[bi % iconColors.Length]"><i class="bi bi-building"></i></div>
                    <h4 style="margin-bottom:6px;">@b.BranchName</h4>
                    <p style="font-size:.82rem;margin-bottom:14px;">@b.Address</p>
                    <a href="tel:@b.BranchContact" class="btn btn-gold btn-sm btn-full"><i class="bi bi-telephone"></i> @b.BranchContact</a>
                    <a href="mailto:@b.BranchEmail" class="btn btn-ghost btn-sm btn-full" style="margin-top:8px;"><i class="bi bi-envelope"></i> Email Branch</a>
                </div>
                bi++;
            }
        </div>
    </div>
</section>
